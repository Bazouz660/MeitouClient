<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Metal backend's host: the game's sky drawn by Metal in a window of its own (the proof the shaders, the uniform
       model and the present work on Metal). macOS only, so it stays out of the solution. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyName>meitou-metal-host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meitou.Metal\Meitou.Metal.csproj" />
  </ItemGroup>

</Project>
