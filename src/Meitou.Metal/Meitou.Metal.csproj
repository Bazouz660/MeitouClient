<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Metal backend: the game's shaders and uniform model on Metal. The engine's GLSL goes through the engine's own
       compiler (shaderc) to SPIR-V and through spirv-cross to MSL in process; the uniform block is the engine's own layout
       (std140 offsets, GlUniforms), so the bytes are the ones the Vulkan path uploads.
       macOS only (SharpMetal P/Invokes /usr/lib/libobjc.A.dylib), so it stays out of the solution: the Windows build never
       sees it. -->

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpMetal" Version="1.1.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meitou.Rendering\Meitou.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meitou.Tests" />
    <InternalsVisibleTo Include="MeitouClient" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Gi/ProbeGi.metal" LogicalName="Meitou.Metal.Gi.ProbeGi.metal" />
  </ItemGroup>

</Project>
