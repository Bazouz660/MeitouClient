<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stage-0 spike: native Metal through SharpMetal, presented onto the GLFW window's CAMetalLayer.
       Local experiment branch only — not part of the solution, not upstream.
       CA1416 suppressed: the spike is macOS-only by construction (Metal exists nowhere else). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpMetal" Version="1.1.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

</Project>
