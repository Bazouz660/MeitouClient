#version 450 core

// A compute pass writing to a storage image - the engine's ocean FFT, Hi-Z pyramid and fog passes
// all do this. Metal has its own rules about which formats a storage image may have, so the probe
// writes rgba16f and reads the storage buffer table back through the fragment stage.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D oTarget;
layout(binding = 1, std430) readonly buffer Table
{
    vec4 items[];
} table;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(p) / 64.0;
    float wave = 0.5 + 0.5 * sin(uv.x * 12.0 + float(p.y) * 0.1);
    imageStore(oTarget, p, vec4(uv, wave, 1.0));
}
