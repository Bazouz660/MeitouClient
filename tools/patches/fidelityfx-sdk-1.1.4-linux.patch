diff --git a/linux/test/ffx_smoke.cpp b/linux/test/ffx_smoke.cpp
new file mode 100644
index 0000000..4263ec5
--- /dev/null
+++ b/linux/test/ffx_smoke.cpp
@@ -0,0 +1,143 @@
+// Smoke test for libamd_fidelityfx_vk.so: dlopen, headless Vulkan device, create and
+// destroy the FSR3 upscaler and frame generation contexts (no window, no swapchain).
+// usage: ffx_smoke /path/to/libamd_fidelityfx_vk.so
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vulkan/vulkan.h>
+#include <ffx_api/ffx_api.h>
+#include <ffx_api/ffx_upscale.h>
+#include <ffx_api/ffx_framegeneration.h>
+#include <ffx_api/vk/ffx_api_vk.h>
+
+typedef ffxReturnCode_t (*PfnCreate)(ffxContext*, ffxCreateContextDescHeader*, const ffxAllocationCallbacks*);
+typedef ffxReturnCode_t (*PfnDestroy)(ffxContext*, const ffxAllocationCallbacks*);
+typedef ffxReturnCode_t (*PfnQuery)(ffxContext*, ffxQueryDescHeader*);
+
+static int failures = 0;
+#define CHECK(cond, what) do { if (!(cond)) { printf("FAIL: %s\n", what); failures++; } else printf("ok:   %s\n", what); } while (0)
+
+static void onMessage(uint32_t type, const wchar_t* msg) { fprintf(stderr, "ffx message (%u): %ls\n", type, msg); }
+
+int main(int argc, char** argv)
+{
+    const char* path = argc > 1 ? argv[1] : "./libamd_fidelityfx_vk.so";
+    void* lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!lib) { printf("dlopen failed: %s\n", dlerror()); return 2; }
+    PfnCreate  create  = (PfnCreate)dlsym(lib, "ffxCreateContext");
+    PfnDestroy destroy = (PfnDestroy)dlsym(lib, "ffxDestroyContext");
+    PfnQuery   query   = (PfnQuery)dlsym(lib, "ffxQuery");
+    CHECK(create && destroy && query && dlsym(lib, "ffxConfigure") && dlsym(lib, "ffxDispatch"), "dlsym of the five entry points");
+    if (!create || !destroy || !query) return 2;
+
+    VkApplicationInfo app = {VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.apiVersion = VK_API_VERSION_1_3;
+    VkInstanceCreateInfo ici = {VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    const char* layers[] = {"VK_LAYER_KHRONOS_validation"};
+    if (getenv("FFX_SMOKE_VALIDATION")) { ici.enabledLayerCount = 1; ici.ppEnabledLayerNames = layers; }
+    VkInstance inst;
+    CHECK(vkCreateInstance(&ici, NULL, &inst) == VK_SUCCESS, "vkCreateInstance");
+
+    uint32_t n = 0;
+    vkEnumeratePhysicalDevices(inst, &n, NULL);
+    VkPhysicalDevice devs[8];
+    if (n > 8) n = 8;
+    vkEnumeratePhysicalDevices(inst, &n, devs);
+    VkPhysicalDevice pd = VK_NULL_HANDLE;
+    for (uint32_t i = 0; i < n; i++)
+    {
+        VkPhysicalDeviceProperties p;
+        vkGetPhysicalDeviceProperties(devs[i], &p);
+        printf("device %u: %s\n", i, p.deviceName);
+        if (p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU && !pd) pd = devs[i];
+    }
+    if (!pd) pd = devs[0];
+
+    uint32_t qn = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(pd, &qn, NULL);
+    VkQueueFamilyProperties qf[16];
+    if (qn > 16) qn = 16;
+    vkGetPhysicalDeviceQueueFamilyProperties(pd, &qn, qf);
+    uint32_t family = 0;
+    for (uint32_t i = 0; i < qn; i++) if (qf[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) { family = i; break; }
+
+    float prio = 1.0f;
+    VkDeviceQueueCreateInfo qci = {VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueFamilyIndex = family; qci.queueCount = 1; qci.pQueuePriorities = &prio;
+    VkPhysicalDeviceVulkan12Features f12 = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+    f12.timelineSemaphore = VK_TRUE; f12.shaderFloat16 = VK_TRUE; f12.storageBuffer8BitAccess = VK_FALSE;
+    VkPhysicalDeviceFeatures2 f2 = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+    f2.pNext = &f12;
+    f2.features.shaderInt16 = VK_TRUE;
+    VkDeviceCreateInfo dci = {VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.pNext = &f2; dci.queueCreateInfoCount = 1; dci.pQueueCreateInfos = &qci;
+    // FFX's Vulkan backend loads these KHR-named entry points whenever the driver *supports*
+    // the extensions, so the application must enable them (Meitou does the same on Windows).
+    const char* wanted[] = {"VK_KHR_get_memory_requirements2", "VK_KHR_dedicated_allocation", "VK_KHR_swapchain"};
+    const char* enabled[8];
+    uint32_t    nEnabled = 0, nExt = 0;
+    vkEnumerateDeviceExtensionProperties(pd, NULL, &nExt, NULL);
+    VkExtensionProperties* exts = (VkExtensionProperties*)calloc(nExt, sizeof(VkExtensionProperties));
+    vkEnumerateDeviceExtensionProperties(pd, NULL, &nExt, exts);
+    for (uint32_t w = 0; w < sizeof(wanted) / sizeof(wanted[0]); w++)
+        for (uint32_t e = 0; e < nExt; e++)
+            if (!strcmp(wanted[w], exts[e].extensionName)) { enabled[nEnabled++] = wanted[w]; break; }
+    free(exts);
+    dci.enabledExtensionCount = nEnabled;
+    dci.ppEnabledExtensionNames = enabled;
+    VkDevice dev;
+    CHECK(vkCreateDevice(pd, &dci, NULL, &dev) == VK_SUCCESS, "vkCreateDevice (headless)");
+
+    ffxCreateBackendVKDesc backend = {};
+    backend.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+    backend.vkDevice = dev;
+    backend.vkPhysicalDevice = pd;
+    backend.vkDeviceProcAddr = (PFN_vkGetDeviceProcAddr)vkGetInstanceProcAddr(inst, "vkGetDeviceProcAddr");
+
+    // FSR3 upscaler
+    ffxCreateContextDescUpscale up = {};
+    up.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+    up.header.pNext = &backend.header;
+    up.flags = FFX_UPSCALE_ENABLE_AUTO_EXPOSURE | FFX_UPSCALE_ENABLE_DEPTH_INVERTED;
+    up.maxRenderSize.width = 1280; up.maxRenderSize.height = 720;
+    up.maxUpscaleSize.width = 1920; up.maxUpscaleSize.height = 1080;
+    up.fpMessage = onMessage;
+    ffxContext upCtx = NULL;
+    ffxReturnCode_t rc = create(&upCtx, &up.header, NULL);
+    printf("FSR3 upscaler create rc=%u\n", rc);
+    CHECK(rc == FFX_API_RETURN_OK && upCtx, "ffxCreateContext FSR3 upscaler");
+    if (upCtx)
+    {
+        ffxQueryDescUpscaleGetJitterPhaseCount jq = {};
+        jq.header.type = FFX_API_QUERY_DESC_TYPE_UPSCALE_GETJITTERPHASECOUNT;
+        int32_t phases = 0;
+        jq.pOutPhaseCount = &phases; jq.displayWidth = 1920; jq.renderWidth = 1280;
+        rc = query(&upCtx, &jq.header);
+        printf("jitter phase count = %d (rc=%u)\n", phases, rc);
+        CHECK(rc == FFX_API_RETURN_OK && phases > 0, "ffxQuery jitter phase count");
+        CHECK(destroy(&upCtx, NULL) == FFX_API_RETURN_OK, "ffxDestroyContext FSR3 upscaler");
+    }
+
+    // Frame generation (not the swapchain: that needs a surface)
+    ffxCreateContextDescFrameGeneration fg = {};
+    fg.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+    fg.header.pNext = &backend.header;
+    fg.flags = FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED;
+    fg.displaySize.width = 1920; fg.displaySize.height = 1080;
+    fg.maxRenderSize.width = 1920; fg.maxRenderSize.height = 1080;
+    fg.backBufferFormat = FFX_API_SURFACE_FORMAT_B8G8R8A8_UNORM;
+    ffxContext fgCtx = NULL;
+    rc = create(&fgCtx, &fg.header, NULL);
+    printf("frame generation create rc=%u\n", rc);
+    CHECK(rc == FFX_API_RETURN_OK && fgCtx, "ffxCreateContext frame generation");
+    if (fgCtx)
+        CHECK(destroy(&fgCtx, NULL) == FFX_API_RETURN_OK, "ffxDestroyContext frame generation");
+
+    vkDestroyDevice(dev, NULL);
+    vkDestroyInstance(inst, NULL);
+    dlclose(lib);
+    printf(failures ? "RESULT: %d failure(s)\n" : "RESULT: all passed\n", failures);
+    return failures ? 1 : 0;
+}
