diff --git a/linux/compat/ffx_linux_compat.h b/linux/compat/ffx_linux_compat.h
new file mode 100644
index 0000000..d476635
--- /dev/null
+++ b/linux/compat/ffx_linux_compat.h
@@ -0,0 +1,195 @@
+// Linux compatibility layer for the AMD FidelityFX SDK 1.1.4 Vulkan sources.
+//
+// The SDK uses a small set of Win32 / MSVC CRT facilities (critical sections,
+// auto-reset events, threads, QueryPerformanceCounter, *_s string functions).
+// Instead of editing every call site, this header provides Linux equivalents
+// with the same names, built on the C++ standard library. It is force-included
+// (-include) in every translation unit and is also what the stub <Windows.h> in
+// this directory resolves to. Not used on Windows.
+//
+// Copyright (c) 2024 Advanced Micro Devices, Inc. (SDK); compat layer under the same MIT licence.
+#pragma once
+
+#ifndef _WIN32
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cmath>
+#include <codecvt>
+#include <locale>
+#include <cstdlib>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cwchar>
+#include <mutex>
+#include <thread>
+#include <pthread.h>
+
+// ---- MSVC CRT ---------------------------------------------------------------
+#ifndef _countof
+#define _countof(a) (sizeof(a) / sizeof((a)[0]))
+#endif
+
+template <size_t N>
+inline int wcscpy_s(wchar_t (&dst)[N], const wchar_t* src)
+{
+    std::wcsncpy(dst, src, N - 1);
+    dst[N - 1] = L'\0';
+    return 0;
+}
+inline int wcscpy_s(wchar_t* dst, size_t n, const wchar_t* src)
+{
+    std::wcsncpy(dst, src, n - 1);
+    dst[n - 1] = L'\0';
+    return 0;
+}
+template <size_t N>
+inline int strcpy_s(char (&dst)[N], const char* src)
+{
+    std::strncpy(dst, src, N - 1);
+    dst[N - 1] = '\0';
+    return 0;
+}
+inline int strcpy_s(char* dst, size_t n, const char* src)
+{
+    std::strncpy(dst, src, n - 1);
+    dst[n - 1] = '\0';
+    return 0;
+}
+#define sprintf_s(buf, size, ...)   std::snprintf((buf), (size), __VA_ARGS__)
+#define swprintf_s(buf, size, ...)  std::swprintf((buf), (size), __VA_ARGS__)
+
+// ---- Win32 basics -------------------------------------------------------------
+typedef uint32_t DWORD;
+typedef uint64_t UINT64;
+typedef int32_t  LONG;
+typedef int      BOOL;
+typedef void*    LPVOID;
+typedef void*    HANDLE;
+#ifndef TRUE
+#define TRUE 1
+#define FALSE 0
+#endif
+#define WINAPI
+#define INFINITE 0xFFFFFFFFu
+#define TEXT(x) x
+#define THREAD_PRIORITY_HIGHEST 2
+
+inline void OutputDebugStringA(const char* s) { std::fputs(s, stderr); }
+inline void OutputDebugStringW(const wchar_t* s) { std::fputws(s, stderr); }
+
+union LARGE_INTEGER
+{
+    struct
+    {
+        DWORD LowPart;
+        LONG  HighPart;
+    };
+    int64_t QuadPart;
+};
+
+// QueryPerformanceCounter: nanoseconds from CLOCK_MONOTONIC (frequency 1e9).
+inline BOOL QueryPerformanceCounter(LARGE_INTEGER* c)
+{
+    c->QuadPart = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    return TRUE;
+}
+inline BOOL QueryPerformanceFrequency(LARGE_INTEGER* f)
+{
+    f->QuadPart = 1000000000ll;
+    return TRUE;
+}
+
+// ---- critical section: Win32 critical sections are recursive ---------------
+struct CRITICAL_SECTION
+{
+    std::recursive_mutex m;
+};
+inline void InitializeCriticalSection(CRITICAL_SECTION*) {}
+inline void DeleteCriticalSection(CRITICAL_SECTION*) {}
+inline void EnterCriticalSection(CRITICAL_SECTION* cs) { cs->m.lock(); }
+inline void LeaveCriticalSection(CRITICAL_SECTION* cs) { cs->m.unlock(); }
+
+// ---- events and threads share one HANDLE type ---------------------------------
+struct FfxLinuxHandle
+{
+    bool                    isThread = false;
+    // event
+    std::mutex              mutex;
+    std::condition_variable cv;
+    bool                    signaled  = false;
+    bool                    autoReset = true;
+    // thread
+    std::thread             thread;
+};
+
+// Name argument is ignored (events are process-local here).
+inline HANDLE CreateEvent(void*, BOOL manualReset, BOOL initialState, const char*)
+{
+    auto* h      = new FfxLinuxHandle();
+    h->autoReset = !manualReset;
+    h->signaled  = initialState != 0;
+    return h;
+}
+inline BOOL SetEvent(HANDLE handle)
+{
+    auto* h = static_cast<FfxLinuxHandle*>(handle);
+    {
+        std::lock_guard<std::mutex> lock(h->mutex);
+        h->signaled = true;
+    }
+    h->cv.notify_all();
+    return TRUE;
+}
+inline DWORD WaitForSingleObject(HANDLE handle, DWORD ms)
+{
+    auto* h = static_cast<FfxLinuxHandle*>(handle);
+    if (h->isThread)
+    {
+        if (h->thread.joinable())
+            h->thread.join();
+        return 0;
+    }
+    std::unique_lock<std::mutex> lock(h->mutex);
+    if (ms == INFINITE)
+        h->cv.wait(lock, [h] { return h->signaled; });
+    else if (!h->cv.wait_for(lock, std::chrono::milliseconds(ms), [h] { return h->signaled; }))
+        return 0x102;  // WAIT_TIMEOUT
+    if (h->autoReset)
+        h->signaled = false;
+    return 0;
+}
+inline BOOL CloseHandle(HANDLE handle)
+{
+    auto* h = static_cast<FfxLinuxHandle*>(handle);
+    if (h->isThread && h->thread.joinable())
+        h->thread.detach();
+    delete h;
+    return TRUE;
+}
+typedef DWORD (*LPTHREAD_START_ROUTINE)(LPVOID);
+inline HANDLE CreateThread(void*, size_t, LPTHREAD_START_ROUTINE fn, LPVOID param, DWORD, DWORD*)
+{
+    auto* h     = new FfxLinuxHandle();
+    h->isThread = true;
+    h->thread   = std::thread([fn, param] { fn(param); });
+    return h;
+}
+// Raising thread priority needs RT privileges on Linux; best effort only (ignored).
+inline BOOL SetThreadPriority(HANDLE, int) { return TRUE; }
+inline BOOL SetThreadDescription(HANDLE handle, const wchar_t* wname)
+{
+    auto*       h = static_cast<FfxLinuxHandle*>(handle);
+    char        name[16] = {};  // pthread names are limited to 15 characters
+    size_t      j = 0;
+    for (size_t i = 0; wname[i] != 0 && j < 15; ++i)
+        if (wname[i] != L' ')
+            name[j++] = (wname[i] < 128) ? static_cast<char>(wname[i]) : '?';
+    pthread_setname_np(h->thread.native_handle(), name);
+    return TRUE;
+}
+
+#endif  // !_WIN32
