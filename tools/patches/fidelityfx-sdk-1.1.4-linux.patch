diff --git a/linux/CMakeLists.txt b/linux/CMakeLists.txt
new file mode 100644
index 0000000..44e7157
--- /dev/null
+++ b/linux/CMakeLists.txt
@@ -0,0 +1,96 @@
+# Linux build of the FidelityFX Vulkan ffx_api library (FSR3 upscaler, frame
+# interpolation, optical flow, frame interpolation swapchain).
+# Own build system: AMD's CMake is Windows-only. Shaders are generated with the
+# Linux build of FidelityFX_SC (see sc/) from AMD's own CMakeShaders*.txt lists.
+cmake_minimum_required(VERSION 3.17)
+project(ffx_linux CXX C)
+
+if(NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release)
+endif()
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+get_filename_component(FFX_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
+set(FFX_SDK_PATH "${FFX_ROOT}/sdk")
+set(FFX_GPU_PATH "${FFX_SDK_PATH}/include/FidelityFX/gpu")
+set(FFX_PASS_SHADER_OUTPUT_PATH "${CMAKE_BINARY_DIR}/shaders")
+file(MAKE_DIRECTORY "${FFX_PASS_SHADER_OUTPUT_PATH}")
+
+# ---- shader compiler (Linux build of FidelityFX_SC, uses system glslangValidator)
+add_subdirectory(sc)
+find_program(GLSLANG_VALIDATOR glslangValidator REQUIRED)
+set(FFX_SC_EXECUTABLE "$<TARGET_FILE:FidelityFX_SC>")
+
+include("${FFX_GPU_PATH}/CMakeCompileShaders.txt")
+
+# AMD's CMakeShaders*.txt glob "shaders/<effect>/*" relative to this directory;
+# linux/shaders is a symlink to sdk/src/backends/vk/shaders.
+# (add_shader_output() appends to FFX_SC_PERMUTATION_OUTPUTS in the caller's scope.)
+function(ffx_generate_effect_shaders FILE)
+    include("${FILE}")
+endfunction()
+
+set(FFX_SC_PERMUTATION_OUTPUTS)
+set(VKCFG "${FFX_SDK_PATH}/src/backends/vk")
+ffx_generate_effect_shaders("${VKCFG}/CMakeShadersFrameinterpolation.txt")
+ffx_generate_effect_shaders("${VKCFG}/CMakeShadersOpticalflow.txt")
+ffx_generate_effect_shaders("${VKCFG}/CMakeShadersFSR3Upscaler.txt")
+# compile_shaders_with_depfile() leaves the variable name itself as the first list entry
+list(FILTER FFX_SC_PERMUTATION_OUTPUTS INCLUDE REGEX "\\.h$")
+add_custom_target(ffx_shaders DEPENDS ${FFX_SC_PERMUTATION_OUTPUTS})
+
+# ---- the library -----------------------------------------------------------
+find_package(Vulkan REQUIRED)
+set(API ${FFX_ROOT}/ffx-api)
+set(SDKSRC ${FFX_SDK_PATH}/src)
+
+set(FFX_LIB_SOURCES
+    ${API}/src/ffx_api.cpp
+    ${API}/src/ffx_provider.cpp
+    ${API}/src/backends.cpp
+    ${API}/src/validation.cpp
+    ${API}/src/ffx_provider_framegeneration.cpp
+    ${API}/src/ffx_provider_fsr3upscale.cpp
+    ${API}/src/vk/ffx_provider_framegenerationswapchain_vk.cpp
+    ${SDKSRC}/backends/vk/ffx_vk.cpp
+    ${SDKSRC}/backends/vk/FrameInterpolationSwapchain/FrameInterpolationSwapchainVK.cpp
+    ${SDKSRC}/backends/vk/FrameInterpolationSwapchain/FrameInterpolationSwapchainVK_Helpers.cpp
+    ${SDKSRC}/backends/vk/FrameInterpolationSwapchain/FrameInterpolationSwapchainVK_UiComposition.cpp
+    ${SDKSRC}/backends/vk/FrameInterpolationSwapchain/FrameInterpolationSwapchainVK_DebugPacing.cpp
+    ${SDKSRC}/backends/shared/ffx_shader_blobs.cpp
+    ${SDKSRC}/backends/shared/blob_accessors/ffx_frameinterpolation_shaderblobs.cpp
+    ${SDKSRC}/backends/shared/blob_accessors/ffx_opticalflow_shaderblobs.cpp
+    ${SDKSRC}/backends/shared/blob_accessors/ffx_fsr3upscaler_shaderblobs.cpp
+    ${SDKSRC}/components/frameinterpolation/ffx_frameinterpolation.cpp
+    ${SDKSRC}/components/opticalflow/ffx_opticalflow.cpp
+    ${SDKSRC}/components/fsr3upscaler/ffx_fsr3upscaler.cpp
+    ${SDKSRC}/shared/ffx_assert.cpp
+    ${SDKSRC}/shared/ffx_message.cpp
+    ${SDKSRC}/shared/ffx_breadcrumbs_list.cpp
+    ${SDKSRC}/shared/ffx_object_management.cpp)
+
+add_library(amd_fidelityfx_vk SHARED ${FFX_LIB_SOURCES})
+add_dependencies(amd_fidelityfx_vk ffx_shaders)
+target_include_directories(amd_fidelityfx_vk PRIVATE
+    ${CMAKE_CURRENT_LIST_DIR}/compat ${FFX_SDK_PATH}/src/shared
+    ${API}/include ${API}/src ${FFX_SDK_PATH}/include ${SDKSRC} ${SDKSRC}/backends ${SDKSRC}/backends/shared
+    ${SDKSRC}/components ${SDKSRC}/backends/vk ${FFX_PASS_SHADER_OUTPUT_PATH})
+target_compile_definitions(amd_fidelityfx_vk PRIVATE
+    FFX_BACKEND_VK FFXDLL_VERSION_MAJOR=1 FFXDLL_VERSION_MINOR=0 FFXDLL_VERSION_PATCH=1
+    FFXDLL_VERSION_API=VK CI_PIPELINE_ID=0 FFX_FSR3UPSCALER FFX_FI FFX_OF FFX_DISABLE_FSR2
+    _UNICODE UNICODE)
+target_compile_options(amd_fidelityfx_vk PRIVATE -include ${CMAKE_CURRENT_LIST_DIR}/compat/ffx_linux_compat.h -fvisibility=hidden -fvisibility-inlines-hidden -fPIC -Wno-unused-result)
+find_package(Threads REQUIRED)
+# Link the system Vulkan loader (libvulkan.so.1); export only the five ffx_api entry points;
+# bundle libstdc++/libgcc so the .so can sit next to the game as a vendor file.
+target_link_libraries(amd_fidelityfx_vk PRIVATE Vulkan::Vulkan Threads::Threads ${CMAKE_DL_LIBS}
+    -static-libstdc++ -static-libgcc
+    -Wl,--no-undefined -Wl,--version-script=${CMAKE_CURRENT_LIST_DIR}/ffx_api.map)
+set_target_properties(amd_fidelityfx_vk PROPERTIES LINK_DEPENDS ${CMAKE_CURRENT_LIST_DIR}/ffx_api.map)
+
+# ---- smoke test (headless Vulkan; run: ffx_smoke ./libamd_fidelityfx_vk.so) -----
+add_executable(ffx_smoke test/ffx_smoke.cpp)
+target_include_directories(ffx_smoke PRIVATE ${API}/include)
+target_link_libraries(ffx_smoke PRIVATE Vulkan::Vulkan ${CMAKE_DL_LIBS})
diff --git a/linux/build.sh b/linux/build.sh
new file mode 100755
index 0000000..eabb366
--- /dev/null
+++ b/linux/build.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+# Build libamd_fidelityfx_vk.so (and the smoke test) on Linux.
+# usage: linux/build.sh [build-dir]   (default: ./build-linux, outside git tracking via .git/info/exclude)
+# Needs: cmake, ninja, gcc or clang, glslangValidator, Vulkan headers + loader.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+build="${1:-$here/../build-linux}"
+cmake -S "$here" -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=Release
+cmake --build "$build" -j"$(nproc)"
+echo "built: $build/libamd_fidelityfx_vk.so"
+echo "test:  $build/ffx_smoke $build/libamd_fidelityfx_vk.so"
