---
// Roadmap: the look of the standalone parity roadmap (demitrix2k.github.io/meitou-parity-roadmap) inside the site's
// header and footer: condensed headings, status tiles and platform chips that filter the rows, category chips
// with a status bar each, one table per category, and Kenshi screenshots behind it that change every 20 s.
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/jetbrains-mono/500.css';
import Base from '../layouts/Base.astro';
import { asOf, allRows, bugs, categories, countBy, fixedSeen, fixedUnseen, order, platformStatus, refUrl, statuses } from '../data/roadmap';
import type { Os, Row } from '../data/roadmap';

const oses: Os[] = ['win', 'linux', 'mac'];
const osShort = { win: 'Win', linux: 'Linux', mac: 'macOS' } as const;
const mark = { works: '✓', untested: '?', wip: '~', bug: '!', missing: '✗', na: '–' } as const;
const platforms = { all: 'All platforms', win: 'Windows', linux: 'Linux', mac: 'macOS', specific: 'Differs by platform' } as const;
const differs = (r: Row) => !!r.platforms && oses.some((os) => platformStatus(r, os) !== platformStatus(r, 'win'));
// Per-row data for the filter script: the status on each platform, whether it differs, whether it has bugs.
const rowData = (r: Row) => JSON.stringify({ s: r.status, p: Object.fromEntries(oses.map((os) => [os, platformStatus(r, os)])), d: differs(r), b: r.bugs.length > 0 });
const counts = countBy(allRows);
const backgrounds = [1, 2, 3, 4].map((i) => `/roadmap-bg/bg-${i}.jpg`);
---
<Base title="Roadmap - Meitou" description="How far each of Kenshi's systems is in Meitou, against unmodded Kenshi 1.0.68.">
  <div class="backdrop" aria-hidden="true" data-bgs={JSON.stringify(backgrounds)}><div></div><div></div></div>
  <div class="rd">
    <header>
      <div class="eyebrow">Meitou against Kenshi 1.0.68</div>
      <h1>What works in Meitou, and what does not yet</h1>
      <p>
        Kenshi's systems, by category. Every system has one status. <b>Works</b> covers what someone has seen working in
        play and reported bugs whose fix is on master; a feature that is only in the code and was never reported is{' '}
        <b>Untested</b>, however complete it looks.
      </p>
      <div class="meta">As of {asOf.date} · <span class="mono">master {asOf.master}</span> · Reference: unmodded Kenshi 1.0.68</div>
    </header>

    <section aria-labelledby="status-h">
      <h2 id="status-h">Status at a glance</h2>
      <div class="bigbar" data-bar="all">{order.map((k) => <span class={`st-${k}`} style={`width: ${(100 * counts[k]) / allRows.length}%`}></span>)}</div>
      <div class="plats" role="group" aria-label="Filter by platform">
        <span class="lbl">Platform</span>
        {Object.entries(platforms).map(([k, v]) => <button type="button" class="chip" data-p={k} aria-pressed={String(k === 'all')}>{v}</button>)}
        <span class="lbl gap">Bugs</span>
        <button type="button" class="chip hbchip" data-bugs aria-pressed="false">Has bugs</button>
      </div>
      <div class="tiles" role="group" aria-label="Filter by status">
        {order.map((k) => (
          <button type="button" class={`tile st-${k}`} data-s={k} aria-pressed="false">
            <span class="n">{counts[k]}</span><span class="k">{statuses[k].label}</span><span class="d">{statuses[k].desc}</span>
          </button>
        ))}
      </div>
      <div class="filter-note">Click a platform, Has bugs or a status to filter the rows. <button type="button" class="clear" hidden>Show all</button></div>
    </section>

    <section aria-labelledby="cats-h">
      <h2 id="cats-h">Categories</h2>
      <nav class="loop" aria-label="Categories">
        {categories.map((c, i) => {
          const cc = countBy(c.rows);
          return (
            <>
              {i > 0 && <span class="arrow" aria-hidden="true">›</span>}
              <a href={`#${c.id}`}>
                <span class="nm">{i + 1}. {c.name}</span>
                <span class="mini" data-bar={c.id}>{order.map((k) => <span class={`st-${k}`} style={`width: ${(100 * cc[k]) / c.rows.length}%`}></span>)}</span>
              </a>
            </>
          );
        })}
      </nav>
    </section>

    {categories.map((c, i) => (
      <section class="stage" id={c.id}>
        <div class="stage-head">
          <span class="eyebrow">Category {i + 1}</span>
          <h2>{c.name}</h2>
          <span class="meta" data-sum={c.id}></span>
          <p>{c.blurb}</p>
        </div>
        <div class="tbl">
          <table>
            <thead><tr><th>System</th><th>Status</th><th>What is known</th></tr></thead>
            <tbody>
              {c.rows.map((r) => (
                <tr id={r.id} data-row={rowData(r)}>
                  <td class="sys">
                    {r.system}
                    {r.bugs.length > 0 && <a class="hb" href="#bugs" title={`Known bugs: ${r.bugs.join(', ')}`}>has bugs · {r.bugs.join(', ')}</a>}
                    {differs(r) && (
                      <span class="obs">
                        {oses.map((os) => {
                          const s = platformStatus(r, os);
                          return <span class={`ob st-${s}`} title={`${osShort[os]}: ${s === 'na' ? 'not applicable' : statuses[s].label}`}>{osShort[os]} {mark[s]}</span>;
                        })}
                      </span>
                    )}
                  </td>
                  <td class="st"><span class={`pill st-${r.status}`}>{statuses[r.status].label}</span></td>
                  <td class="note">{r.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="empty-stage" hidden>No rows match the filters in this category.</div>
        </div>
      </section>
    ))}

    <section id="bugs" class="stage" aria-labelledby="bugs-h">
      <h2 id="bugs-h">Known bugs</h2>
      <p class="meta">Open differences and faults seen in play, as issues on GitHub.</p>
      <div class="tbl">
        <table>
          <thead><tr><th>ID</th><th>What is seen</th><th>What the original does</th><th>State</th><th>Platform</th></tr></thead>
          <tbody>
            {bugs.map((b) => (
              <tr>
                <td class="ref">{refUrl(b.id) ? <a href={refUrl(b.id)}>{b.id}</a> : b.id}</td>
                <td>{b.seen}</td>
                <td class="note">{b.original}</td>
                <td class="note">{b.state}</td>
                <td class="note">{b.platform ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="fixed-h">
      <h2 id="fixed-h">Recently fixed</h2>
      <div class="cols">
        <div>
          <h3>Fixed on master</h3>
          <p class="meta">Not yet seen in play.</p>
          <ul class="fixlist">{fixedUnseen.map((f) => <li><span class="tag">{refUrl(f.id) ? <a href={refUrl(f.id)}>{f.id}</a> : f.id || '—'}</span><span>{f.text}</span></li>)}</ul>
        </div>
        <div>
          <h3>Fixed and seen in play</h3>
          <p class="meta">Merged and checked in the game.</p>
          <ul class="fixlist">{fixedSeen.map((f) => <li><span class="tag">{refUrl(f.id) ? <a href={refUrl(f.id)}>{f.id}</a> : f.id || '—'}</span><span>{f.text}</span></li>)}</ul>
        </div>
      </div>
    </section>
  </div>
  <a class="totop" href="#top" aria-label="Back to top" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 14l6-6 6 6" /></svg>
    <span>Top</span>
  </a>
</Base>

<script is:inline>
  // Backdrop: a random screenshot at load, then a different one every 20 s, cross-faded (not while the tab is hidden).
  (() => {
    const box = document.querySelector('.backdrop'), bgs = JSON.parse(box.dataset.bgs), layers = box.children;
    let cur = Math.floor(Math.random() * bgs.length), front = 0;
    layers[0].style.backgroundImage = `url(${bgs[cur]})`;
    layers[0].classList.add('on');
    setInterval(() => {
      if (document.hidden) return;
      let next = Math.floor(Math.random() * (bgs.length - 1)); if (next >= cur) next++;
      const img = new Image();
      img.onload = () => {
        const back = layers[1 - front];
        back.style.backgroundImage = `url(${bgs[next]})`;
        back.classList.add('on'); layers[front].classList.remove('on');
        front = 1 - front; cur = next;
      };
      img.src = bgs[next];
    }, 20000);
  })();

  // Back to top: shown once the page is scrolled past the first screen; smooth unless reduced motion is asked for.
  (() => {
    const btn = document.querySelector('.totop');
    const toggle = () => { btn.hidden = scrollY < innerHeight; };
    addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      history.replaceState(null, '', location.pathname + location.search);
    });
  })();

  // Filters: one status at a time (click again to clear), one platform, and systems with known bugs. Counts and bars follow the platform.
  (() => {
    const ORDER = ['works', 'untested', 'wip', 'bug', 'missing'];
    const LABEL = { works: 'Works', untested: 'Untested', wip: 'WIP', bug: 'Bug', missing: 'Missing', na: 'N/A' };
    const PLAT = { win: 'Windows', linux: 'Linux', mac: 'macOS' };
    let active = null, plat = 'all', onlyBugs = false;
    const rows = [...document.querySelectorAll('tr[data-row]')].map((tr) => ({ tr, ...JSON.parse(tr.dataset.row) }));
    const on = (r) => plat === 'all' ? true : plat === 'specific' ? r.d : r.p[plat] !== 'na';
    const st = (r) => (plat in PLAT ? r.p[plat] : r.s);
    const bar = (el, rs) => { const n = rs.length; el.querySelectorAll('span').forEach((s, i) => { s.style.width = n ? `${(100 * rs.filter((r) => st(r) === ORDER[i]).length) / n}%` : '0'; }); };
    const note = document.querySelector('.filter-note'), clear = note.querySelector('.clear'), plain = note.firstChild.textContent;
    function apply() {
      const vis = rows.filter(on);
      bar(document.querySelector('[data-bar="all"]'), vis);
      document.querySelectorAll('.tile').forEach((t) => {
        t.querySelector('.n').textContent = vis.filter((r) => st(r) === t.dataset.s).length;
        t.setAttribute('aria-pressed', String(t.dataset.s === active));
      });
      document.querySelector('.tiles').classList.toggle('filtering', !!active);
      document.querySelectorAll('.chip[data-p]').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.p === plat)));
      document.querySelector('[data-bugs]').setAttribute('aria-pressed', String(onlyBugs));
      document.querySelectorAll('.stage[id]:not(#bugs)').forEach((sec) => {
        const rs = rows.filter((r) => sec.contains(r.tr)), shown = rs.filter(on);
        bar(document.querySelector(`[data-bar="${sec.id}"]`), shown);
        sec.querySelector('[data-sum]').textContent = shown.length
          ? ORDER.map((k) => [k, shown.filter((r) => st(r) === k).length]).filter(([, n]) => n).map(([k, n]) => `${n} ${LABEL[k].toLowerCase()}`).join(' · ')
          : 'nothing for this platform';
        let any = false;
        rs.forEach((r) => {
          const s = on(r) ? st(r) : r.s, show = on(r) && (!active || s === active) && (!onlyBugs || r.b);
          const pill = r.tr.querySelector('.pill'); pill.className = `pill st-${s}`; pill.textContent = LABEL[s];
          r.tr.hidden = !show; any ||= show;
        });
        sec.querySelector('table').hidden = !any;
        sec.querySelector('.empty-stage').hidden = any;
      });
      const parts = [];
      if (plat !== 'all') parts.push(plat === 'specific' ? 'rows whose status differs by platform' : `the status on ${PLAT[plat]}`);
      if (active) parts.push(`${LABEL[active]} only`);
      if (onlyBugs) parts.push('systems with known bugs');
      note.firstChild.textContent = parts.length ? `Showing ${parts.join(', ')}. ` : plain;
      clear.hidden = !parts.length;
    }
    document.querySelector('.tiles').addEventListener('click', (e) => { const t = e.target.closest('.tile'); if (!t) return; active = active === t.dataset.s ? null : t.dataset.s; apply(); });
    document.querySelector('.plats').addEventListener('click', (e) => {
      const c = e.target.closest('.chip'); if (!c) return;
      if (c.hasAttribute('data-bugs')) onlyBugs = !onlyBugs; else plat = c.dataset.p;
      apply();
    });
    clear.addEventListener('click', () => { active = null; plat = 'all'; onlyBugs = false; apply(); });
    apply();
  })();
</script>

<style is:global>
  /* The body and the site frame are transparent on this page so the backdrop shows behind them (html keeps the ground colour). */
  body:has(.rd), .mt-scene:has(.rd) { background: transparent; }
</style>

<style>
  .backdrop, .rd {
    --bg: #1c1613; --surface: #2a201b; --fg: #eadfcb; --muted: #a8977f; --line: #3d312a; --accent: #e07b45;
    --works: #7fd09c; --works-bg: #1f3a2a; --untested: #a7b1ac; --untested-bg: #2a312d;
    --wip: #e6b84e; --wip-bg: #3d321a; --bug: #f08b82; --bug-bg: #432522; --missing: #c3a6ec; --missing-bg: #352a45;
    --font-display: "Barlow Condensed", "Arial Narrow", sans-serif;
    --font-body: "Source Sans 3", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }
  .backdrop { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: var(--bg); }
  .backdrop div { position: absolute; inset: -32px; background-size: cover; background-position: center; filter: blur(3px) saturate(.9); opacity: 0; }
  .backdrop div.on { opacity: 1; }
  .backdrop::after { content: ""; position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 70%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .backdrop div { transition: opacity 1.5s ease; } }

  .rd { max-width: 1080px; margin: 0 auto; padding: 8px 0 64px; display: grid; gap: 40px; color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.5; }
  .rd section { display: grid; gap: 12px; min-width: 0; }
  .rd :is(h1, h2, h3) { font-family: var(--font-display); text-wrap: balance; margin: 0; letter-spacing: .01em; color: var(--fg); }
  .rd h1 { font-size: 2.6rem; font-weight: 700; line-height: 1.05; }
  .rd h2 { font-size: 1.6rem; font-weight: 600; }
  .rd h3 { font-size: 1.2rem; font-weight: 600; }
  .rd p { margin: 0; max-width: 70ch; }
  .rd a { color: var(--accent); }
  .mono { font-family: var(--font-mono); font-size: .85em; }
  .eyebrow { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-size: .85rem; color: var(--muted); font-weight: 600; }
  .meta { color: var(--muted); font-size: .9rem; }
  header { display: grid; gap: 10px; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
  .tile { font: inherit; color: inherit; text-align: left; cursor: pointer; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px 12px 16px; display: grid; gap: 2px; position: relative; overflow: hidden; }
  .tile::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--c); }
  .tile .n { font-family: var(--font-display); font-size: 2.1rem; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; color: var(--c); }
  .tile .k { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; }
  .tile .d { color: var(--muted); font-size: .85rem; }
  .tile:hover, .tile:focus-visible { border-color: var(--c); outline: none; }
  .tile[aria-pressed="true"] { border-color: var(--c); box-shadow: inset 0 0 0 1px var(--c); }
  .tiles.filtering .tile[aria-pressed="false"] { opacity: .55; }
  .plats { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .plats .lbl { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .1em; font-size: .8rem; color: var(--muted); font-weight: 600; margin-right: 4px; }
  .plats .gap { margin-left: 10px; }
  .chip { font: inherit; font-size: .9rem; cursor: pointer; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; }
  .chip:hover, .chip:focus-visible { border-color: var(--accent); outline: none; }
  .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .chip.hbchip[aria-pressed="true"] { background: var(--bug); border-color: var(--bug); }
  .rd .hb { display: inline-block; margin-left: 8px; font-family: var(--font-mono); font-size: .7rem; font-weight: 500; line-height: 1.5; padding: 0 6px; border-radius: 3px; color: var(--bug); border: 1px solid var(--bug); text-decoration: none; white-space: nowrap; vertical-align: 1px; }
  .rd .hb:hover, .rd .hb:focus-visible { background: var(--bug-bg); outline: none; }
  .obs { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px; }
  .ob { font-family: var(--font-mono); font-size: .7rem; font-weight: 500; line-height: 1.5; padding: 0 5px; border-radius: 3px; color: var(--c); background: var(--cb); white-space: nowrap; }
  .st-na { --c: var(--muted); --cb: transparent; border: 1px dashed var(--line); }
  .filter-note { font-size: .9rem; color: var(--muted); }
  .filter-note button { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }

  .bigbar { display: flex; height: 12px; border-radius: 6px; overflow: hidden; background: var(--untested-bg); }
  .bigbar span, .mini span { display: block; height: 100%; background: var(--c); }

  .loop { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .rd .loop a { text-decoration: none; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 6px 10px; display: grid; gap: 4px; min-width: 118px; }
  .rd .loop a:hover, .rd .loop a:focus-visible { border-color: var(--accent); outline: none; }
  .loop .nm { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; }
  .loop .mini { display: flex; height: 5px; border-radius: 3px; overflow: hidden; background: var(--untested-bg); }
  .loop .arrow { color: var(--muted); font-family: var(--font-display); }

  .pill { display: inline-block; font-size: .78rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; white-space: nowrap; letter-spacing: .02em; color: var(--c); background: var(--cb); }
  .st-works { --c: var(--works); --cb: var(--works-bg); }
  .st-untested { --c: var(--untested); --cb: var(--untested-bg); }
  .st-wip { --c: var(--wip); --cb: var(--wip-bg); }
  .st-bug { --c: var(--bug); --cb: var(--bug-bg); }
  .st-missing { --c: var(--missing); --cb: var(--missing-bg); }

  .stage { scroll-margin-top: 16px; }
  .stage-head { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; }
  .stage-head p { color: var(--muted); flex-basis: 100%; }
  .tbl { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
  table { border-collapse: collapse; width: 100%; min-width: 680px; }
  th, td { text-align: left; vertical-align: top; padding: 9px 12px; border-bottom: 1px solid var(--line); }
  tbody tr:last-child td { border-bottom: 0; }
  th { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; color: var(--muted); }
  td.sys { font-weight: 600; width: 30%; }
  td.st { width: 1%; white-space: nowrap; }
  td.note { color: var(--muted); font-size: .92rem; }
  td.ref { width: 1%; white-space: nowrap; font-family: var(--font-mono); font-size: .8rem; }
  .rd td.ref a { text-decoration: none; }
  .empty-stage { color: var(--muted); font-size: .9rem; padding: 10px 12px; }
  /* A row linked as /roadmap#<row id> is marked. */
  tr[id] { scroll-margin-top: 24px; }
  tr:target td { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  tr:target td.sys { box-shadow: inset 3px 0 0 var(--accent); }
  tr[hidden], table[hidden], [hidden] { display: none !important; }

  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .cols > div { display: grid; gap: 10px; min-width: 0; align-content: start; }
  .fixlist { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .fixlist li { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: baseline; }
  .fixlist li > span:last-child { min-width: 0; }
  .tag { font-family: var(--font-mono); font-size: .78rem; color: var(--muted); white-space: nowrap; }

  /* Back to top: bottom right (the Ko-fi button takes the bottom left). */
  .totop {
    position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: max(16px, env(safe-area-inset-bottom, 0px)); z-index: 5;
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--fg);
    font: 600 1rem/1 var(--font-display); letter-spacing: .06em; text-transform: uppercase; text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .45);
    --bg: #1c1613; --surface: #2a201b; --fg: #eadfcb; --line: #3d312a; --accent: #e07b45; --font-display: "Barlow Condensed", "Arial Narrow", sans-serif;
  }
  .totop:hover, .totop:focus-visible { border-color: var(--accent); color: var(--accent); outline: none; }
  @media (prefers-reduced-motion: no-preference) { .totop { transition: border-color .15s, color .15s; } }

  @media (max-width: 560px) { .rd h1 { font-size: 2rem; } }
  @media (prefers-reduced-motion: no-preference) { .tile, .rd .loop a { transition: border-color .15s, opacity .15s; } }
</style>
